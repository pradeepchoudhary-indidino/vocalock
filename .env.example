# Copy to .env.local. Absent or empty means the app uses its on-device SQLite
# database, which is how it ships today.
#
# Point this at the API server once it is deployed (see server/).
VITE_API_BASE=
# Google "Web application" OAuth client id (same as the server's
# GOOGLE_WEB_CLIENT_ID). Empty means "Continue with Google" signs in a local
# test user, which only works without VITE_API_BASE.
VITE_GOOGLE_WEB_CLIENT_ID=
