# Copy to .env and fill in. Never commit the real file.

# AWS RDS PostgreSQL. Use the writer endpoint.
DATABASE_URL=postgres://vocalock:CHANGEME@vocalock.abcdefg.ap-south-1.rds.amazonaws.com:5432/vocalock
# RDS requires TLS; set to "false" only against a local postgres.
PGSSL=true

PORT=8080
# 127.0.0.1 when nginx on the same machine fronts it; 0.0.0.0 in Docker.
HOST=127.0.0.1

# Browser origins allowed to call the API. https://localhost is the Android
# app's WebView; http://localhost:5173 is `npm run dev`.
CORS_ORIGINS=https://localhost,http://localhost:5173
# Proxies in front of the server (1 behind an ALB / App Runner / Render), so
# rate limits see the real client IP. 0 when it is exposed directly.
TRUST_PROXY=1

# Google Cloud Console → APIs & Services → Credentials → the "Web application"
# OAuth client. Sign-in ID tokens are checked against it. The app uses the
# same id as VITE_GOOGLE_WEB_CLIENT_ID.
GOOGLE_WEB_CLIENT_ID=

# Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_ keys until
# go-live. Leave blank to keep the no-payment trial.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The ₹199-every-30-days plan; create it once with scripts/razorpay-plan.sh.
RAZORPAY_PLAN_ID=
# Set on the webhook (Dashboard → Webhooks) pointed at https://<api>/webhooks/razorpay
# with the subscription.* events.
RAZORPAY_WEBHOOK_SECRET=

# Meta Conversions API, for reporting renewals (charged while the app is
# closed) to Meta ads. Events Manager → your dataset → Settings → Conversions
# API → Generate access token. Leave blank to send nothing.
META_DATASET_ID=
META_ACCESS_TOKEN=
