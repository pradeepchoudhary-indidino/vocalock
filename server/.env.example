# Copy to .env and fill in. Never commit the real file.

# AWS RDS PostgreSQL. Use the writer endpoint.
DATABASE_URL=postgres://vocalock:CHANGEME@vocalock.abcdefg.ap-south-1.rds.amazonaws.com:5432/vocalock
# RDS requires TLS; set to "false" only against a local postgres.
PGSSL=true

PORT=8080

# While no SMS provider is connected the OTP is the static one below and no
# message is sent. Set to false once a provider is wired into sendSms().
STATIC_OTP=true
STATIC_OTP_CODE=1234

# Shared secret the app sends as a Bearer token. Rotate before going public.
API_TOKEN=CHANGEME
