<?xml version="1.0" encoding="utf-8"?>
<!-- The VocaLock mark: a microphone between two sound waves, with the level
     bars knocked out of its head. Traced from the canvas's Logo artboard.

     Adaptive icons are 108dp but only the middle 72dp is guaranteed visible, so
     the 120-unit artwork is scaled to ~61dp and centred: it stays inside the
     safe zone whatever mask the launcher applies. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="23.4"
        android:translateY="23.4"
        android:scaleX="0.51"
        android:scaleY="0.51">

        <!-- outer waves -->
        <path
            android:pathData="M20,28 Q6,50 20,72"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeAlpha="0.55" />
        <path
            android:pathData="M100,28 Q114,50 100,72"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeAlpha="0.55" />

        <!-- inner waves -->
        <path
            android:pathData="M32,36 Q22,50 32,64"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M88,36 Q98,50 88,64"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round" />

        <!-- mic head -->
        <path
            android:pathData="M60,50 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0z"
            android:fillColor="#FFFFFF" />

        <!-- mic body -->
        <path
            android:pathData="M51,64 H69 L75,94 Q75.6,98 72,98 H48 Q44.4,98 45,94 Z"
            android:fillColor="#FFFFFF" />

        <!-- level bars, in the brand blue -->
        <path
            android:pathData="M52,45 h0 a2,2 0 0,1 2,2 v6 a2,2 0 0,1 -2,2 h0 a2,2 0 0,1 -2,-2 v-6 a2,2 0 0,1 2,-2 z"
            android:fillColor="#1669C5" />
        <path
            android:pathData="M60,39 h0 a2,2 0 0,1 2,2 v18 a2,2 0 0,1 -2,2 h0 a2,2 0 0,1 -2,-2 v-18 a2,2 0 0,1 2,-2 z"
            android:fillColor="#1669C5" />
        <path
            android:pathData="M68,43 h0 a2,2 0 0,1 2,2 v10 a2,2 0 0,1 -2,2 h0 a2,2 0 0,1 -2,-2 v-10 a2,2 0 0,1 2,-2 z"
            android:fillColor="#1669C5" />
    </group>
</vector>
