# Copy to keystore.properties and fill in. NEVER commit the real file.
#
# Create the keystore first (you choose the password; do not lose it — losing it
# means you can never ship an update to the same app on Play):
#
#   keytool -genkeypair -v \
#     -keystore android/vocalock-release.jks \
#     -alias vocalock -keyalg RSA -keysize 4096 -validity 10000
#
storeFile=vocalock-release.jks
storePassword=
keyAlias=vocalock
keyPassword=
